# Supabase environment variables for the Angular frontend
# Copy this file to `.env` and fill in your project URL and anon/public key.
# Do not commit your real keys.

# Your Supabase project URL (e.g., https://xyzcompany.supabase.co)
NG_APP_SUPABASE_URL=https://your-project.supabase.co

# Your Supabase anon/public key (NOT the service role)
NG_APP_SUPABASE_KEY=your-anon-public-key
